# Environment Configuration Template
# Copy this file to .env and fill in actual values
# NEVER commit .env file to version control

# Flask Configuration
SECRET_KEY=change-me-to-random-secure-key-min-32-chars
FLASK_ENV=development
PORT=8000

# Database Configuration (PostgreSQL)
# SECURITY: These values MUST come from environment/secrets manager in production
DB_HOST=postgresql.thoughts-app.svc.cluster.local
DB_NAME=thoughts
DB_USER=thoughts
DB_PASSWORD=REPLACE_WITH_ACTUAL_PASSWORD_FROM_VAULT
DB_PORT=5432

# Logging
LOG_LEVEL=INFO

# SECURITY NOTES:
# 1. Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# 2. In production, use Kubernetes secrets or Vault for DB_PASSWORD
# 3. Never hardcode credentials in application code
# 4. Rotate credentials regularly
# 5. Use least-privilege database user (read-only if possible)
