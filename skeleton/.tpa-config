# Red Hat Trusted Profile Analyzer (TPA) Configuration
# Generated by Backstage template

# Enable TPA package vulnerability checking
TPA_ENABLED=${{ values.enable_tpa_package_check }}

# TPA Server Configuration
TPA_URL=${{ values.tpa_url }}
TPA_OIDC_ISSUER=${{ values.tpa_oidc_issuer }}
TPA_CLIENT_ID=${{ values.tpa_client_id }}

# TPA Client Secret (fetch from Kubernetes Secret or Vault)
# DO NOT HARDCODE - this is injected at runtime
# TPA_CLIENT_SECRET will be set from environment or secret manager

# Usage:
# 1. Export TPA_CLIENT_SECRET from your secret manager
# 2. Run: source .tpa-config
# 3. Run: ./scripts/check_package.sh <package> <version>
